{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Andrew0613/PAWBench/schemas/run-summary-v1.schema.json",
  "title": "PAWEval run summary (v1)",
  "description": "Aggregated summary.json for one evaluation run. 'formal' status requires the benchmark's full formal grid (official scene set per selected split, formal K, zero infrastructure failures) and is comparable with published results; diagnostic statuses carry an explicit warning and are not comparable. Deterministic output: no timestamps, no run IDs. Draft status: authoritative validation lives in pawbench.results.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark",
    "system",
    "prompt_set",
    "judge",
    "denominator",
    "status",
    "per_scene",
    "calibration",
    "coverage"
  ],
  "properties": {
    "schema_version": { "const": "paweval.run_summary/v1" },
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset_id", "benchmark_revision"],
      "properties": {
        "dataset_id": { "type": "string", "minLength": 1 },
        "benchmark_revision": { "type": "integer", "minimum": 1 }
      }
    },
    "system": { "type": "string", "minLength": 1 },
    "prompt_set": { "type": "string", "minLength": 1 },
    "judge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model"],
      "properties": {
        "model": { "type": "string", "minLength": 1 }
      },
      "$comment": "Endpoint and credentials are never serialized."
    },
    "denominator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_slots",
        "judged",
        "model_failure",
        "infrastructure_failure"
      ],
      "properties": {
        "expected_slots": { "type": "integer", "minimum": 1 },
        "judged": { "type": "integer", "minimum": 0 },
        "model_failure": { "type": "integer", "minimum": 0 },
        "infrastructure_failure": { "type": "integer", "minimum": 0 }
      }
    },
    "status": {
      "enum": [
        "formal",
        "diagnostic_partial_grid",
        "diagnostic_infra_failure"
      ]
    },
    "warning": {
      "type": "string",
      "$comment": "Required for diagnostic statuses; explains why the run is not comparable to formal results."
    },
    "per_scene": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scene_id",
          "split",
          "split_order",
          "n",
          "error_count",
          "judged_label_counts",
          "scene_passed"
        ],
        "properties": {
          "scene_id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9-]*$" },
          "split": { "enum": ["calibration", "coverage"] },
          "split_order": { "type": "integer", "minimum": 0 },
          "n": { "type": "integer", "minimum": 0 },
          "error_count": { "type": "integer", "minimum": 0 },
          "judged_label_counts": {
            "type": "object",
            "additionalProperties": { "type": "integer", "minimum": 0 }
          },
          "tvd": {
            "oneOf": [
              { "type": "number", "minimum": 0, "maximum": 1 },
              { "type": "null" }
            ],
            "$comment": "Calibration scenes only; null when the scene is unscorable (no strict rows)."
          },
          "support_recovery": {
            "oneOf": [
              { "type": "number", "minimum": 0, "maximum": 1 },
              { "type": "null" }
            ],
            "$comment": "Coverage scenes only; null when unscorable."
          },
          "scene_passed": {
            "oneOf": [{ "type": "boolean" }, { "type": "null" }],
            "$comment": "error_count <= n/2; null when unscorable."
          }
        }
      }
    },
    "calibration": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["macro_tvd", "n_pass"],
          "properties": {
            "macro_tvd": {
              "oneOf": [
                { "type": "number", "minimum": 0, "maximum": 1 },
                { "type": "null" }
              ]
            },
            "n_pass": { "type": "string", "pattern": "^[0-9]+/[0-9]+$" }
          }
        }
      ]
    },
    "coverage": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["macro_support_recovery", "n_pass"],
          "properties": {
            "macro_support_recovery": {
              "oneOf": [
                { "type": "number", "minimum": 0, "maximum": 1 },
                { "type": "null" }
              ]
            },
            "n_pass": { "type": "string", "pattern": "^[0-9]+/[0-9]+$" }
          }
        }
      ]
    }
  }
}
